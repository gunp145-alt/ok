    label.TextColor3 = Color3.fromRGB(185, 195, 205)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left

    local valLabel = Instance.new("TextLabel", container)
    valLabel.Size = UDim2.new(0, 60, 0, 22)
    valLabel.Position = UDim2.new(1, -74, 0, 6)
    valLabel.BackgroundTransparency = 1
    valLabel.TextColor3 = Color3.fromRGB(0, 230, 255)
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextSize = 11
    valLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", container)
    track.Size = UDim2.new(1, -28, 0, 4)
    track.Position = UDim2.new(0, 14, 0, 36)
    track.BackgroundColor3 = Color3.fromRGB(40, 45, 60)
    Instance.new("UICorner", track)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((Config[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    Instance.new("UICorner", fill)

    local knob = Instance.new("TextButton", track)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new((Config[key] - min) / (max - min), -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Text = ""
    Instance.new("UICorner", knob)

    local function update()
        valLabel.Text = decimal and string.format("%.2f", Config[key]) or tostring(math.floor(Config[key]))
        label.Text = name
        local pct = math.clamp((Config[key] - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -7, 0.5, -7)
    end
    update()

    local slideActive = false
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then slideActive = true end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if slideActive and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local pct = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            Config[key] = min + ((max - min) * pct)
            update()
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then slideActive = false end
    end)
end

