-- // 11. AUTOMATIC SEARCH ENGINE //
local function getClosestTarget()
    local target, minMag = nil, math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    
    local function evaluate(model, isPlayer, plyrObj)
        if model == player.Character then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local targetHitbox = model:FindFirstChild(Config.TargetPart) or model.PrimaryPart or model:FindFirstChild("Head")
        
        if hum and targetHitbox and hum.Health > 0 then
            if Config.TeamCheck and isPlayer and plyrObj.Team == player.Team then return end
            
            local pos, onScreen = camera:WorldToViewportPoint(targetHitbox.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                if dist <= Config.FovRadius and dist < minMag then
                    if Config.WallCheck then
                        local params = RaycastParams.new()
                        params.FilterDescendantsInstances = {player.Character, model}
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        local ray = workspace:Raycast(camera.CFrame.Position, targetHitbox.Position - camera.CFrame.Position, params)
                        if ray then return end
                    end
                    minMag = dist
                    target = targetHitbox
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then evaluate(p.Character, true, p) end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then evaluate(obj, false, nil) end
    end
    
    return target
end

-- // 12. RUNSERVICE UPDATE PIPELINE //
RunService.RenderStepped:Connect(function()
    -- FOV Ring Placement
    fovRing.Visible = Config.Aimbot
    fovRing.Size = UDim2.new(0, Config.FovRadius * 2, 0, Config.FovRadius * 2)
    fovRing.Position = UDim2.new(0, (camera.ViewportSize.X/2) - Config.FovRadius, 0, (camera.ViewportSize.Y/2) - Config.FovRadius)

    -- Tracking Engine
    if Config.Aimbot then
        if not currentLockedTarget or not currentLockedTarget.Parent or not currentLockedTarget.Parent:FindFirstChildOfClass("Humanoid") or currentLockedTarget.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then
            currentLockedTarget = getClosestTarget()
        end
        
        if currentLockedTarget then
            local pos, onScreen = camera:WorldToViewportPoint(currentLockedTarget.Position)
            local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
            local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
            
            local isVisible = true
            if Config.WallCheck then
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {player.Character, currentLockedTarget.Parent}
                params.FilterType = Enum.RaycastFilterType.Exclude
                local ray = workspace:Raycast(camera.CFrame.Position, currentLockedTarget.Position - camera.CFrame.Position, params)
                if ray then isVisible = false end
            end
            
            if onScreen and dist <= Config.FovRadius and isVisible then
                camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, currentLockedTarget.Position), Config.Smoothness)
            else
                currentLockedTarget = nil 
            end
        end
    else
        currentLockedTarget = nil
    end

    -- Hyper-Throttled Instant Triggerbot Engine
    if Config.Triggerbot then
        local target = mouse.Target
        if target and target.Parent then
            local char = target:FindFirstAncestorOfClass("Model")
            if char and char:FindFirstChildOfClass("Humanoid") and char ~= player.Character then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 then
                    local isEnemy = true
                    if Config.TeamCheck then
                        local plyrObj = Players:GetPlayerFromCharacter(char)
                        if plyrObj and plyrObj.Team == player.Team then 
                            isEnemy = false 
                        end
                    end
                    
                    if isEnemy and mouse1click then
                        -- Threaded fire loops execute instantly with zero frame delays
                        task.spawn(mouse1click)
                    end
                end
            end
        end
    end

    -- ESP Visuals Engine
    local function renderVisuals(model, isPlayer, plyrObj)
        if model == player.Character then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local targetHitbox = model:FindFirstChild(Config.TargetPart) or model.PrimaryPart or model:FindFirstChild("Head")
        
        if hum and targetHitbox and hum.Health > 0 then
            local isTeammate = Config.TeamCheck and isPlayer and plyrObj.Team == player.Team
            local isTargeted = currentLockedTarget and currentLockedTarget.Parent == model
            
            local highlight = model:FindFirstChild("Q_ESP_High")
            if Config.EspHighlight and not isTeammate then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "Q_ESP_High"
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = model
                end
                highlight.FillColor = isTargeted and Theme.Accent or Color3.fromRGB(255, 255, 255)
                highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
                highlight.FillTransparency = 0.6
                highlight.OutlineTransparency = 0.2
                highlight.Enabled = true
            elseif highlight then
                highlight:Destroy()
            end

            local boxName = "Q_Box_" .. model.Name
            local box = screenGui:FindFirstChild(boxName)
            
            if Config.EspBoxes and not isTeammate then
                local pos, onScreen = camera:WorldToViewportPoint(targetHitbox.Position)
                if onScreen then
                    if not box then
                        box = Instance.new("Frame", screenGui)
                        box.Name = boxName
                        box.BackgroundTransparency = 1
                        box.Active = false
                        local bStroke = Instance.new("UIStroke", box)
                        bStroke.Thickness = 1
                    end
                    box.UIStroke.Color = isTargeted and Theme.Accent or Color3.fromRGB(220, 220, 220)
                    
                    local dist = (camera.CFrame.Position - targetHitbox.Position).Magnitude
                    local h = math.clamp(2400 / dist, 8, 600)
                    local w = h * 0.6
                    box.Size = UDim2.new(0, w, 0, h)
                    box.Position = UDim2.new(0, pos.X - (w/2), 0, pos.Y - (h/2))
                    box.Visible = true
                elseif box then
                    box.Visible = false
                end
            elseif box then
                box:Destroy()
            end
        else
            if model:FindFirstChild("Q_ESP_High") then model.Q_ESP_High:Destroy() end
            local box = screenGui:FindFirstChild("Q_Box_" .. model.Name)
            if box then box:Destroy() end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then renderVisuals(p.Character, true, p) end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then renderVisuals(obj, false, nil) end
    end
end)

Players.PlayerRemoving:Connect(function(plyr)
    local box = screenGui:FindFirstChild("Q_Box_" .. plyr.Name)
    if box then box:Destroy() end
end)
