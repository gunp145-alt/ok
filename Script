local function computeBestTarget()
    local target, minDistance = nil, math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("Humanoid") and item.Parent and item.Parent ~= player.Character and item.Health > 0 then
            local model = item.Parent
            local head = model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
            
            if head then
                local associatedPlayer = Players:GetPlayerFromCharacter(model)
                if Config.TeamCheck and associatedPlayer and associatedPlayer.Team == player.Team then continue end
                
                local screenPos, visibleOnScreen = camera:WorldToViewportPoint(head.Position)
                if visibleOnScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if screenDist <= Config.FovRadius and screenDist < minDistance then
                        if Config.WallCheck then
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = {player.Character, model}
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            
                            local rayResult = workspace:Raycast(camera.CFrame.Position, (head.Position - camera.CFrame.Position), params)
                            if rayResult then continue end
                        end
                        minDistance = screenDist
                        target = head
                    end
                end
            end
        end
    end
    return target
end

-- // REAL-TIME SCHEDULER & PIPELINE RENDERER //
RunService.RenderStepped:Connect(function()
    fovVisualizer.Visible = Config.AimbotEnabled
    fovVisualizer.Size = UDim2.new(0, Config.FovRadius * 2, 0, Config.FovRadius * 2)
    fovVisualizer.Position = UDim2.new(0, (camera.ViewportSize.X / 2) - Config.FovRadius, 0, (camera.ViewportSize.Y / 2) - Config.FovRadius)
    Instance.new("UICorner", fovVisualizer).CornerRadius = UDim.new(1, 0)

    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("Humanoid") and item.Parent and item.Parent ~= player.Character then
            local char = item.Parent
            local primary = char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
            local assocPlayer = Players:GetPlayerFromCharacter(char)
            
            if Config.TeamCheck and assocPlayer and assocPlayer.Team == player.Team then 
                local oldHl = char:FindFirstChild("EspHighlight")
                if oldHl then oldHl.Enabled = false end
                local oldBox = screenGui:FindFirstChild("Box_" .. char.Name)
                if oldBox then oldBox.Visible = false end
                continue 
            end

            -- Render Highlights (Chams)
            local highlight = char:FindFirstChild("EspHighlight")
            if Config.EspEnabled and Config.EspChams and item.Health > 0 then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "EspHighlight"
                    highlight.Parent = char
                end
                highlight.FillColor = (Config.TeamColorEsp and assocPlayer) and assocPlayer.TeamColor.Color or Color3.fromRGB(0, 215, 255)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.55
                highlight.Enabled = true
            elseif highlight then
                highlight.Enabled = false
            end

            -- Render Box Overlays
            local box = screenGui:FindFirstChild("Box_" .. char.Name)
            if Config.EspEnabled and Config.EspBoxes and primary and item.Health > 0 then
                local pos, visible = camera:WorldToViewportPoint(primary.Position)
                if visible then
                    if not box then
                        box = Instance.new("Frame")
                        box.Name = "Box_" .. char.Name
                        box.BackgroundTransparency = 1
                        box.BorderSizePixel = 0
                        local bs = Instance.new("UIStroke", box)
                        bs.Thickness = 1.5
                        box.Parent = screenGui
                    end
                    box.UIStroke.Color = (Config.TeamColorEsp and assocPlayer) and assocPlayer.TeamColor.Color or Color3.fromRGB(0, 215, 255)
                    local distFactor = math.clamp(1000 / (camera.CFrame.Position - primary.Position).Magnitude, 8, 120)
                    box.Size = UDim2.new(0, distFactor, 0, distFactor * 1.3)
                    box.Position = UDim2.new(0, pos.X - (box.Size.X.Offset / 2), 0, pos.Y - (box.Size.Y.Offset / 2))
                    box.Visible = true
                elseif box then
                    box.Visible = false
                end
            elseif box then
                box.Visible = false
            end
        end
    end

    if Config.AimbotEnabled and not mainFrame.Visible then
        local optimalTarget = computeBestTarget()
        if optimalTarget then
            camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, optimalTarget.Position), Config.Smoothness)
        end
    end
end)
