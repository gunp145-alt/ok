-- // OPTIMIZED TARGET ACQUISITION (SCANS PLAYERS, NOT WORKSPACE) //
local function computeTargetForRadius(radius)
    local target, minDistance = nil, math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == player then continue end
        if Config.TeamCheck and otherPlayer.Team == player.Team then continue end
        
        local char = otherPlayer.Character
        if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local head = char:FindFirstChild("Head") or char.PrimaryPart
            if head then
                local screenPos, visible = camera:WorldToViewportPoint(head.Position)
                if visible then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist <= radius and dist < minDistance then
                        if Config.WallCheck then
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = {player.Character, char}
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            local rayResult = workspace:Raycast(camera.CFrame.Position, (head.Position - camera.CFrame.Position), params)
                            if rayResult then continue end
                        end
                        minDistance = dist
                        target = head
                    end
                end
            end
        end
    end
    return target
end

-- // FIXED SILENT AIM HOOK (WITH CHECKCALLER TO PREVENT DETECTION) //
local oldIndex
local oldNamecall

oldIndex = hookmetatable(game, {
    __index = function(self, index)
        if not checkcaller() and self == mouse and (index == "Hit" or index == "Target") and Config.SilentAimEnabled and not mainFrame.Visible then
            local target = computeTargetForRadius(Config.SilentFov)
            if target then
                if index == "Hit" then return target.CFrame end
                if index == "Target" then return target end
            end
        end
        return oldIndex(self, index)
    end
})

oldNamecall = hookmetatable(game, {
    __namecall = function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if not checkcaller() and Config.SilentAimEnabled and not mainFrame.Visible then
            local target = computeTargetForRadius(Config.SilentFov)
            if target then
                if method == "Raycast" and self == workspace then
                    args[2] = (target.Position - args[1]).Unit * 1000
                    return oldNamecall(self, unpack(args))
                elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and self == workspace then
                    local ray = args[1]
                    args[1] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * 1000)
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end
})

-- // MAIN SCHEDULE STEP SYSTEM RENDERER //
local espBoxes = {}

RunService.RenderStepped:Connect(function()
    local cx, cy = camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2

    -- Update FOV Circles
    if Config.AimbotMaster and Config.AimbotActive and not mainFrame.Visible then
        aimFovCircle.Visible = true
        aimFovCircle.Size = UDim2.new(0, Config.AimbotFov * 2, 0, Config.AimbotFov * 2)
        aimFovCircle.Position = UDim2.new(0, cx - Config.AimbotFov, 0, cy - Config.AimbotFov)
    else
        aimFovCircle.Visible = false
    end

    if Config.SilentAimEnabled and not mainFrame.Visible then
        silentFovCircle.Visible = true
        silentFovCircle.Size = UDim2.new(0, Config.SilentFov * 2, 0, Config.SilentFov * 2)
        silentFovCircle.Position = UDim2.new(0, cx - Config.SilentFov, 0, cy - Config.SilentFov)
    else
        silentFovCircle.Visible = false
    end

    -- Optimized ESP Loop (Using Players instead of Workspace)
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == player then continue end
        
        local char = otherPlayer.Character
        local isValid = char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
        local isEnemy = not (Config.TeamCheck and otherPlayer.Team == player.Team)
        local head = isValid and (char:FindFirstChild("Head") or char.PrimaryPart) or nil

        -- Handle Box ESP
        if Config.EspEnabled and Config.EspBoxes and isValid and isEnemy and head then
            local pos, onScreen = camera:WorldToViewportPoint(head.Position)
            if onScreen then
                if not espBoxes[otherPlayer] then
                    local box = Instance.new("Frame", screenGui)
                    box.BackgroundTransparency = 1
                    local stroke = Instance.new("UIStroke", box)
                    stroke.Thickness = 1.5
                    espBoxes[otherPlayer] = box
                end
                
                local box = espBoxes[otherPlayer]
                box.UIStroke.Color = (Config.TeamColorEsp and otherPlayer.Team) and otherPlayer.TeamColor.Color or Color3.fromRGB(0, 215, 255)
                local distFactor = math.clamp(1000 / pos.Z, 10, 150)
                box.Size = UDim2.new(0, distFactor, 0, distFactor * 1.5)
                box.Position = UDim2.new(0, pos.X - (box.Size.X.Offset / 2), 0, pos.Y - (box.Size.Y.Offset / 2))
                box.Visible = true
            elseif espBoxes[otherPlayer] then
                espBoxes[otherPlayer].Visible = false
            end
        elseif espBoxes[otherPlayer] then
            espBoxes[otherPlayer].Visible = false
        end

        -- Handle Chams (Highlights)
        if isValid and isEnemy then
            local hl = char:FindFirstChild("EspChams")
            if Config.EspEnabled and Config.EspChams then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "EspChams"
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.Parent = char
                end
                hl.FillColor = (Config.TeamColorEsp and otherPlayer.Team) and otherPlayer.TeamColor.Color or Color3.fromRGB(0, 215, 255)
                hl.Enabled = true
            elseif hl then
                hl.Enabled = false
            end
        end
    end

    -- Camera Lock Update
    if Config.AimbotMaster and Config.AimbotActive and not mainFrame.Visible then
        local optimalTarget = computeTargetForRadius(Config.AimbotFov)
        if optimalTarget then
            camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, optimalTarget.Position), Config.Smoothness)
        end
    end
end)

-- Player Cleanup for ESP
Players.PlayerRemoving:Connect(function(removedPlayer)
    if espBoxes[removedPlayer] then
        espBoxes[removedPlayer]:Destroy()
        espBoxes[removedPlayer] = nil
    end
end)
