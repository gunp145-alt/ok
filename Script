local function computeBestTarget()
    local target, minDistance = nil, math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent and obj.Health > 0 then
            local char = obj.Parent
            if char == player.Character or char:IsDescendantOf(screenGui) then continue end
            
            local associatedPlayer = Players:GetPlayerFromCharacter(char)
            if Config.TeamCheck and associatedPlayer and associatedPlayer.Team == player.Team then continue end
            
            local head = char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
            if head then
                local screenPos, visibleOnScreen = camera:WorldToViewportPoint(head.Position)
                if visibleOnScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if screenDist <= Config.FovRadius and screenDist < minDistance then
                        if Config.WallCheck then
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = {player.Character, char}
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            
                            local rayResult = workspace:Raycast(camera.CFrame.Position, (head.Position - camera.CFrame.Position), params)
                            if rayResult then continue end
                        end
                        minDistance = screenDist
                        target = head
                    end
                end
            end
        end
    end
    return target
end

-- // SILENT AIM METATABLE INTERCEPTION MODULE //
-- Hooks into the mouse position matrix to spoof calculations silently
local oldIndex
oldIndex = hookmetatable(game, {
    __index = function(self, index)
        if self == mouse and (index == "Hit" or index == "Target") and Config.SilentAimEnabled and not mainFrame.Visible then
            local silentTarget = computeBestTarget()
            if silentTarget then
                if index == "Hit" then
                    return silentTarget.CFrame
                elseif index == "Target" then
                    return silentTarget
                end
            end
        end
        return oldIndex(self, index)
    end
})

-- // SEPARATE ASYNCHRONOUS TRIGGERBOT LOOP //
task.spawn(function()
    while true do
        task.wait(0.01)
        if Config.TriggerbotEnabled and not mainFrame.Visible then
            local mouseTarget = mouse.Target
            if mouseTarget and mouseTarget.Parent then
                local character = mouseTarget.Parent
                local humanoid = character:FindFirstChildWhichIsA("Humanoid") or (character.Parent and character.Parent:FindFirstChildWhichIsA("Humanoid"))
                
                if humanoid and humanoid.Health > 0 and humanoid.Parent ~= player.Character then
                    local targetChar = humanoid.Parent
                    if not targetChar:IsDescendantOf(screenGui) then
                        local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
                        if not targetPlayer or not (Config.TeamCheck and targetPlayer.Team == player.Team) then
                            VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, true, game, 1)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, false, game, 1)
                        end
                    end
                end
            end
        end
    end
end)

-- // REAL-TIME SCHEDULER & PIPELINE RENDERER //
RunService.RenderStepped:Connect(function()
    -- Show FOV circle if either Aimbot or Silent Aim is active
    fovVisualizer.Visible = (Config.AimbotEnabled or Config.SilentAimEnabled)
    fovVisualizer.Size = UDim2.new(0, Config.FovRadius * 2, 0, Config.FovRadius * 2)
    fovVisualizer.Position = UDim2.new(0, (camera.ViewportSize.X / 2) - Config.FovRadius, 0, (camera.ViewportSize.Y / 2) - Config.FovRadius)
    Instance.new("UICorner", fovVisualizer).CornerRadius = UDim.new(1, 0)

    local currentTargets = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent and obj.Health > 0 then
            local char = obj.Parent
            if char == player.Character or char:IsDescendantOf(screenGui) then continue end
            
            local assocPlayer = Players:GetPlayerFromCharacter(char)
            if Config.TeamCheck and assocPlayer and assocPlayer.Team == player.Team then continue end
            
            local primary = char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
            if primary then
                local cacheId = "Box_" .. char.Name .. "_" .. char:GetDebugId()
                currentTargets[cacheId] = true
                
                -- Render Highlights (Chams)
                local highlight = char:FindFirstChild("EspHighlight")
                if Config.EspEnabled and Config.EspChams then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "EspHighlight"
                        highlight.Parent = char
                    end
                    highlight.FillColor = (Config.TeamColorEsp and assocPlayer) and assocPlayer.TeamColor.Color or Color3.fromRGB(0, 215, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.55
                    highlight.Enabled = true
                elseif highlight then
                    highlight.Enabled = false
                end

                -- Render Box Overlays
                local box = screenGui:FindFirstChild(cacheId)
                if Config.EspEnabled and Config.EspBoxes then
                    local pos, visible = camera:WorldToViewportPoint(primary.Position)
                    if visible then
                        if not box then
                            box = Instance.new("Frame")
                            box.Name = cacheId
                            box.BackgroundTransparency = 1
                            box.BorderSizePixel = 0
                            local bs = Instance.new("UIStroke", box)
                            bs.Thickness = 1.5
                            box.Parent = screenGui
                        end
                        box.UIStroke.Color = (Config.TeamColorEsp and assocPlayer) and assocPlayer.TeamColor.Color or Color3.fromRGB(0, 215, 255)
                        local distFactor = math.clamp(1000 / (camera.CFrame.Position - primary.Position).Magnitude, 8, 120)
                        box.Size = UDim2.new(0, distFactor, 0, distFactor * 1.3)
                        box.Position = UDim2.new(0, pos.X - (box.Size.X.Offset / 2), 0, pos.Y - (box.Size.Y.Offset / 2))
                        box.Visible = true
                    elseif box then
                        box.Visible = false
                    end
                elseif box then
                    box.Visible = false
                end
            end
        end
    end

    -- Cleanup dead frames
    for _, element in ipairs(screenGui:GetChildren()) do
        if element:IsA("Frame") and string.match(element.Name, "^Box_") and not currentTargets[element.Name] then
            element:Destroy()
        end
    end

    -- Standard Camera Lock (Only runs if Silent Aim is turned off)
    if Config.AimbotEnabled and not Config.SilentAimEnabled and not mainFrame.Visible then
        local optimalTarget = computeBestTarget()
        if optimalTarget then
            camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, optimalTarget.Position), Config.Smoothness)
        end
    end
end)
